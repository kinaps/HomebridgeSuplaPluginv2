{
  "displayName": "Supla Plugin",
  "name": "homebridge-supla-v2",
  "version": "2.1.5",
  "description": "Plugin for Homebridge to control Supla devices",
  "license": "Apache-2.0",
  "author": "Norbert Spanik",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kamilolek/HomebridgeSuplaPlugin.git"
  },
  "engines": {
    "node": ">=18.17.0",
    "homebridge": ">=2.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
